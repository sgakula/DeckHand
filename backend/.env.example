# Copy to .env for local development. In Cloud Run these come from --set-env-vars / Secret Manager.

GOOGLE_CLOUD_PROJECT=your-project-id
# 'global' is required for the newest Gemini models on Vertex AI
GOOGLE_CLOUD_LOCATION=global

# Use Vertex AI (recommended on Cloud Run; uses the service account, no API key needed)
GOOGLE_GENAI_USE_VERTEXAI=true
# OR use the Gemini API key instead (local dev): set GOOGLE_GENAI_USE_VERTEXAI=false and:
GOOGLE_API_KEY=

# Models (override if your project has different access)
GEMINI_MODEL=gemini-3.5-flash
GEMINI_LIVE_MODEL=gemini-3.5-flash-live
IMAGE_MODEL=gemini-3.5-flash-image

# Infra
PUBSUB_TOPIC=deckhand-jobs
GCS_BUCKET=your-project-id-deckhand-assets

# OAuth client for user-consented Google Workspace access (Slides/Gmail/Calendar/Drive).
# Create an OAuth 2.0 Client ID (Web) in the Cloud console; store the secret in Secret Manager in prod.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8080/auth/google/callback

# Frontend origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:3000

# Local dev only: skip Firebase ID token verification and act as this uid. NEVER set in prod.
DEV_FAKE_UID=

# Optional: enable Cloud Trace export
ENABLE_TRACING=false
