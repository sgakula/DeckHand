# Copy to deploy/vars.env and fill in, then: source deploy/vars.env
export PROJECT_ID=your-project-id
export REGION=us-central1
export PUBSUB_TOPIC=deckhand-jobs
export GCS_BUCKET=${PROJECT_ID}-deckhand-assets
export FRONTEND_ORIGIN=https://your-frontend.example.com
export OAUTH_CLIENT_ID=xxxxx.apps.googleusercontent.com
# The OAuth client secret goes into Secret Manager in setup.sh, never in this file's git copy.
