rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Members read presentations directly (realtime UI); ALL writes go through the API.
    match /presentations/{pid} {
      allow read: if request.auth != null
        && (request.auth.uid in resource.data.member_uids
            || request.auth.uid == resource.data.owner_uid);
      allow write: if false;

      match /{sub=**} {
        allow read: if request.auth != null
          && (request.auth.uid in get(/databases/$(database)/documents/presentations/$(pid)).data.member_uids
              || request.auth.uid == get(/databases/$(database)/documents/presentations/$(pid)).data.owner_uid);
        allow write: if false;
      }
    }

    // Profile is readable by its owner; private/ (OAuth tokens) is server-only.
    match /users/{uid}/meta/{doc} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /users/{uid}/private/{doc} {
      allow read, write: if false;
    }

    match /jobs/{jobId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
  }
}
